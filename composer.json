{
    "name": "snipershady/ip2location",
    "description": "Free wrapper to easily implements ip2location.com free API",
    "keywords": ["ip2location", "geolocation", "ip2location.com"],
    "homepage": "https://www.spinfo.it",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Stefano Perrini",
            "email": "perrini.stefano@gmail.com",
            "homepage": "https://www.spinfo.it"
        }
    ],
    "autoload": {
        "psr-4": {
            "IpToLocation\\": "src/"
        }       
    },
    "autoload-dev": {
        "psr-4": {
            "IpToLocation\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-curl": "*",
        "snipershady/typeidentifier": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.23",
        "phpstan/phpstan": "^2.2.9",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "phpunit/phpunit": "^12.5.34",
        "rector/rector": "^2.6.4"
    }
}
